# Copy to .env and fill in real values. Never commit .env.
APP_NAME=Streamlit Starter
DATA_SOURCE=demo

# Server-side only: read with os.getenv("API_KEY"), never render it.
API_KEY=

# SkyCiv Load Generator. Read by code/skyciv_load_generator.py. Never commit real values.
SKYCIV_USERNAME=
SKYCIV_KEY=

# Project assistant: any OpenAI-compatible server. Defaults target a local Ollama.
# Setup: `ollama serve` then `ollama pull llama3.1:8b`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
