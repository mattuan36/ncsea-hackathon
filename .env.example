# Copy to .env and fill in real values. Never commit .env.
# Backend database connection (used by backend/app/db.py).
DATABASE_URL=postgresql://app:app@localhost:55432/structural_app

APP_NAME=Streamlit Starter
DATA_SOURCE=demo

# Server-side only: read with os.getenv("API_KEY"), never render it.
API_KEY=

# SkyCiv Load Generator. Read by the site API on the server. Never commit real values.
SKYCIV_USERNAME=
SKYCIV_KEY=

# Browsers allowed to call the site API. The key is not one of these values.
API_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,https://mattuan36.github.io

# Project assistant: any OpenAI-compatible server. Defaults target a local Ollama.
# Setup: `ollama serve` then `ollama pull llama3.1:8b`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
