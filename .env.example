# Copy to .env and fill in real values. Never commit .env.

# Backend database connection (used by backend/app/db.py). Local: the docker-compose db.
# Deployed (Fly secret): the Supabase Postgres connection string, with ?sslmode=require.
DATABASE_URL=******localhost:55432/structural_app

# SkyCiv Load Generator. Read by the site API on the server. Never commit real values.
SKYCIV_USERNAME=
SKYCIV_KEY=

# Browsers allowed to call the site API. The key is not one of these values.
API_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,https://mattuan36.github.io

# Frontend public Supabase config (used in frontend/src/supabase/client.ts).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
